# Public — bundled into the client.
# Mezo testnet (chain id 31611)
NEXT_PUBLIC_RPC_URL=https://rpc.test.mezo.org
NEXT_PUBLIC_CHAIN_ID=31611

# MUSDirectDebit deployment (set after running scripts/deploy-and-tick.sh)
NEXT_PUBLIC_SCHEDULER_ADDRESS=

# Live Mezo testnet contract addresses (verified 2026-05-04)
NEXT_PUBLIC_MUSD_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
NEXT_PUBLIC_TROVE_MANAGER_ADDRESS=0xE47c80e8c23f6B4A1aE41c34837a0599D5D16bb0
NEXT_PUBLIC_PRICE_FEED_ADDRESS=0x86bCF0841622a5dAC14A313a15f96A95421b9366

# WalletConnect — get one at https://cloud.reown.com (optional; defaults to a placeholder).
# Without a real project id, only browser-injected wallets work; WalletConnect won't.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID
