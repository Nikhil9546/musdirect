{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@musdirect/sdk": ["./node_modules/@musdirect/sdk/src"],
      "@musdirect/x402": ["./node_modules/@musdirect/x402/src"],
      "viem": ["./node_modules/viem"],
      "viem/*": ["./node_modules/viem/*"],
      "wagmi": ["./node_modules/wagmi"],
      "wagmi/*": ["./node_modules/wagmi/*"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "node_modules/@musdirect/sdk/src/**/*.ts",
    "node_modules/@musdirect/sdk/src/**/*.tsx",
    "node_modules/@musdirect/x402/src/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
